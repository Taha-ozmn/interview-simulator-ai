{
  "expo": {
    "name": "Interview Simulator AI",
    "slug": "interview-simulator-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "interview-simulator",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.interviewsimulator.ai",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Mülakat sorularını sesli yanıtlamak için konuşma tanıma kullanılır.",
        "NSMicrophoneUsageDescription": "Sesli mülakat modu için mikrofon erişimi gereklidir."
      }
    },
    "android": {
      "package": "com.interviewsimulator.ai",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sesli mülakat modu için mikrofon erişimi gereklidir.",
          "speechRecognitionPermission": "Mülakat sorularını sesli yanıtlamak için konuşma tanıma kullanılır."
        }
      ],
      "expo-secure-store"
    ]
  }
}
